ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=your_deepseek_api_key_here
ANTHROPIC_AUTH_TOKEN=your_deepseek_api_key_here
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# 本机和 Compose 内部的 MCP 请求直接连接，避免被系统代理转发。
NO_PROXY=localhost,127.0.0.1,::1,notes-mcp,host.docker.internal

# 笔记 MCP 的 HTTP 认证令牌，使用 scripts/configure_notes_token.py 生成；不填则拒绝启动 HTTP 服务。
NOTES_MCP_TOKEN=

# 可选：不设置时使用 backend/data/workbench.db 和 backend/agents。
# WORKBENCH_DATABASE_PATH=/absolute/path/workbench.db
# WORKBENCH_AGENTS_DIRECTORY=/absolute/path/agents
# WORKBENCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 每轮实际返回的 Skill 正文字数预算；绑定数量和绑定正文总量不受此值限制。
# WORKBENCH_SKILL_READ_BUDGET_CHARS=80000
# Daily database copies kept in backend/data/backups by default; 0 turns them off.
# WORKBENCH_BACKUP_KEEP=7
# WORKBENCH_BACKUP_DIRECTORY=/absolute/path/backups

# 自有域名部署时配置允许的 Host；本地默认 localhost,127.0.0.1,testserver,backend。
# WORKBENCH_TRUSTED_HOSTS=localhost,127.0.0.1,workbench.example.com
# 浏览器安装目录；本地不设置时使用 backend/data/browsers。
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/browsers
# 默认 auto：优先使用已安装的普通 Google Chrome，否则使用已准备的 Chromium。
# 可选 chrome / msedge / chromium；始终创建工作台独立会话，不复用个人浏览资料。
# WORKBENCH_BROWSER_CHANNEL=auto
# Local macOS defaults to native_mcp; other hosts retain legacy until explicitly configured.
# Install runtime: .venv/bin/python scripts/install_browser_mcp.py
# Native mode is for an attended local computer; browser websites use normal networking.
WORKBENCH_BROWSER_PROVIDER=native_mcp
